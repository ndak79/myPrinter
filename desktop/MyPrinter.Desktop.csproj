<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MyPrinter</AssemblyName>
    <RootNamespace>MyPrinter.Desktop</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- App manifest: request admin for WMI/printer access, DPI awareness -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI: PerMonitorV2 (replaces manifest windowsSettings to avoid WFO0003) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Suppress harmless WindowsBase version conflict from WebView2 WPF shim -->
    <MSBuildWarningsAsErrors />
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Keep native runtime files beside the app; the installer build supplies the win-x64 RID. -->
  <PropertyGroup>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WebView2 (WinForms only – the WPF shim causes a harmless WindowsBase version warning; suppress it) -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39">
      <ExcludeAssets>none</ExcludeAssets>
    </PackageReference>

    <!-- Backend API (same solution) -->
    <ProjectReference Include="..\backend\PrinterApp.csproj" />
  </ItemGroup>

  <!-- Bundle frontend files into output directory -->
  <ItemGroup>
    <None Include="..\frontend\**\*" Exclude="..\frontend\**\*.backup;..\frontend\**\_fix_guide.js;..\frontend\tests\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>frontend\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="..\THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>THIRD-PARTY-NOTICES.txt</Link>
    </None>
  </ItemGroup>

</Project>
